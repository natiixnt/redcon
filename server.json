{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.natiixnt/redcon",
  "title": "redcon",
  "description": "Deterministic context packing for AI coding agents; measured 83% fewer input tokens, local.",
  "repository": {
    "url": "https://github.com/natiixnt/redcon",
    "source": "github"
  },
  "version": "1.16.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "redcon",
      "version": "1.16.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "redcon[mcp]"
        },
        {
          "type": "positional",
          "value": "redcon"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
